# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=seu_token_aqui

# ID da aplicação (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=id_da_aplicacao

# ID do servidor (Modo Desenvolvedor ativado > botão direito no servidor > Copiar ID)
# OBRIGATÓRIA. O mesmo código roda em MAIS DE UMA instalação (um serviço por servidor de Discord),
# cada uma com seu token, seu volume e seu banco. GUILD_ID é o que amarra ESTA instalação ao SEU
# servidor: o bot recusa qualquer interação, evento ou tarefa vinda de outro guild (utils/guildGuard.js).
# Sem ela — ou com valor que não seja um ID numérico — o boot ABORTA de propósito.
GUILD_ID=id_do_servidor

# ID do cargo de Staff/Administração — controle total, fora da hierarquia jurídica
CARGO_STAFF_ID=id_do_cargo_staff

# IDs das categorias onde os canais-ticket são criados
CATEGORIA_PROCESSOS_PENAIS_ID=id_da_categoria_processos_penais
CATEGORIA_PROCESSOS_CIVEIS_ID=id_da_categoria_processos_civeis
CATEGORIA_MEDIDAS_ID=id_da_categoria_medidas
CATEGORIA_APELACOES_ID=id_da_categoria_apelacoes
CATEGORIA_PETICOES_ID=id_da_categoria_peticoes
CATEGORIA_RECONSIDERACOES_ID=id_da_categoria_reconsideracoes
CATEGORIA_ARQUIVADOS_ID=id_da_categoria_arquivados
CATEGORIA_SISBAJUS_ID=id_da_categoria_sisbajus

# Canais de acompanhamento/publicação
# Canal "Advogar - Pegar Casos" (onde a capa pública dos processos é postada e o advogado se
# habilita/entra no caso). A env antiga CANAL_DIARIO_OFICIAL_ID ainda funciona como fallback.
CANAL_ADVOGAR_PEGAR_CASOS_ID=id_do_canal_advogar_pegar_casos
CANAL_AUDITORIA_ID=id_do_canal_auditoria
CANAL_CHANGELOG_ID=id_do_canal_changelog
CANAL_PAINEL_ID=id_do_canal_painel
CANAL_OFICIOS_ID=
CANAL_REQUERIMENTO_POLICIA_CIVIL_ID=id_do_canal_requerimento_policia_civil
# (Frente 2.1) Id do webhook específico da Polícia Civil que posta os requerimentos. OBRIGATÓRIO:
# a integração FALHA FECHADO — sem este id, TODO requerimento é rejeitado (evita que qualquer
# webhook no canal forje uma medida cautelar). Descubra o id olhando um requerimento real (é o
# message.webhookId), pela URL do webhook (o número entre /webhooks/<ID>/token), ou em
# Configurações do canal > Integrações > Webhooks.
WEBHOOK_REQUERIMENTO_POLICIA_CIVIL_ID=

# IDs dos cargos (Roles) do Discord atribuídos automaticamente pelo /rh contratar
ROLE_DELEGADO_ID=id_do_cargo_delegado
ROLE_PROMOTOR_ID=id_do_cargo_promotor
ROLE_JUIZ_ID=id_do_cargo_juiz
ROLE_ADVOGADO_ID=id_do_cargo_advogado
ROLE_DESEMBARGADOR_ID=id_do_cargo_desembargador
ROLE_PROCURADOR_ID=id_do_cargo_procurador
ROLE_SUPER_STAFF_ID=id_do_cargo_super_staff

# Webhooks de integração externa (opcional — deixe em branco se não usar)
WEBHOOK_CERTIDOES_URL=
WEBHOOK_DEVOLUTIVA_POLICIA_CIVIL_URL=
WEBHOOK_MINISTERIO_PUBLICO_URL=

# MODO MANUTENÇÃO — SKIP_BOOT_TASKS=1 sobe o bot SEM nenhuma tarefa automática (sem auto-criação de
# canais, sem backfill, sem varredura de fantasma/Diário, sem checagem de prazo, sem painel fixo).
# Use ao religar um serviço que ficou parado: os prazos correm por relógio, e no primeiro boot o bot
# aplicaria de uma vez todo o atraso (indeferimentos, dativos, reatribuições, publicações no Diário),
# tudo sem desfazer. Confira o estado, REMOVA a variável e reinicie pra religar as tarefas.
# Só o valor exato "1" liga; qualquer outro valor mantém o comportamento normal. Interações de
# usuário continuam sendo atendidas. Ver utils/modoManutencao.js.
SKIP_BOOT_TASKS=

# Caminho do banco (dados.json) — só necessário em produção com disco efêmero (Railway/Render):
# aponte pro volume persistente, ex: /data/dados.json. Em dev local, deixe em branco.
DADOS_JSON_PATH=
