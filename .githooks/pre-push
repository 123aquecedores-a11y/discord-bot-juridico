#!/bin/sh
# SUÍTE COMPLETA OBRIGATÓRIA ANTES DE TODO PUSH — não é escolha manual.
#
# Por que hook de pre-push, e não de pre-commit: commit é barato e frequente (rascunho, WIP,
# bisect). Push é o que chega no GitHub e dispara o deploy automático do Railway — é ali que a
# suíte tem que ser inegociável.
#
# Por que .githooks/ versionado, e não .git/hooks/: hook em .git/hooks não vai no repositório e
# some no próximo clone. O `prepare` do package.json aponta core.hooksPath para cá em todo
# `npm install`, então quem clonar e instalar ganha o hook sem precisar lembrar de nada.
#
# Contorno consciente: `git push --no-verify` pula. É de propósito — emergência existe. O que não
# pode existir é pular POR ESQUECIMENTO, e para isso a barreira precisa ser ativa, não uma
# lembrança.

echo ""
echo "──────────────────────────────────────────────────────────────"
echo "  pre-push: SUÍTE COMPLETA com FULL_RENDER=1 (renderização"
echo "  integral, sem stub). Para pular numa emergência de"
echo "  verdade: git push --no-verify"
echo "──────────────────────────────────────────────────────────────"
echo ""

# FULL_RENDER=1 no hook, e não no `npm run test:completo`, de propósito: o dia a dia roda a suíte
# dezenas de vezes e não precisa pagar a renderização integral a cada vez — mas o que CHEGA em
# produção precisa ter passado por ela. O push é a fronteira, então é aqui que a flag entra.
# Ver scripts/README-testes.md.
FULL_RENDER=1 npm run test:completo
resultado=$?

if [ $resultado -ne 0 ]; then
  echo ""
  echo "❌ PUSH BLOQUEADO — a suíte completa falhou."
  echo "   Conserte antes de subir: o push dispara deploy automático em produção."
  echo ""
  exit 1
fi

echo ""
echo "✅ Suíte completa passou. Seguindo com o push."
echo ""
exit 0
